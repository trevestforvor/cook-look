{
  "name": "chroma",
  "version": "0.1.0",
  "private": true,
  "description": "Chroma — a color-theory design engine with a deterministic OKLCH core and an Adobe Color–style editor.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @chroma/web dev",
