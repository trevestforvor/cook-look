# Chroma environment configuration
#
# Part 1 (this milestone) is a fully deterministic color engine + editor UI and
# requires NO environment variables to run. The variables below are reserved for
# Part 2, which adds a provider-agnostic AI design agent that steers the engine
# via tool calls. They are documented here so the contract is stable.

# Which LLM provider the Part 2 agent will use: "openai" | "anthropic"
LLM_PROVIDER=anthropic

# Provider API keys (server-side only — never exposed to the browser).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
