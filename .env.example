# Chroma environment configuration
#
# The color engine and editor run with NO environment variables. These are only
# needed for Part 2's AI design agent (the assist panel). Keys are read
# server-side (in the /api/agent route) and never reach the browser.

# Which LLM provider the design agent uses: "openai" | "anthropic".
# Switching providers requires ZERO code changes — only this variable.
LLM_PROVIDER=anthropic

# Provider API keys (server-side only).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (sensible defaults are used if unset).
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-7
