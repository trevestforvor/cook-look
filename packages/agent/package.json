{
  "name": "@chroma/agent",
  "version": "0.1.0",
  "description": "Provider-agnostic AI design agent that steers the Chroma engine via tool calls. Never emits color values directly — only calls engine tools and explains the results.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "methodology.md"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@chroma/engine": "workspace:*",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
