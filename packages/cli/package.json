{
  "name": "@chroma/cli",
  "version": "0.1.0",
  "description": "Composable, agent-friendly CLI over the Chroma color engine (noun-verb commands, --json output).",
  "type": "module",
  "bin": {
    "chroma": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js='#!/usr/bin/env node' && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chroma/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
